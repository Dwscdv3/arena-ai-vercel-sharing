# 复制为 .env（本地开发用）；生产环境请在 Vercel 项目 Settings → Environment Variables 中设置，切勿提交真实值。

# 创建分享链接所需的 secret token（用户脚本里也使用同一个值）
SHARE_TOKEN=change-me-to-a-long-random-string

# Vercel KV / Upstash Redis REST 凭据（在 Vercel Storage 创建 KV 并关联到项目后自动注入）
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
